    {
      "id": "b6cf64c9-7786-5459-928a-3c79ef57fcab",
      "name": "Build report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "jsCode": "// The form only collects the report; W1 owns intake (validation, idempotency, enrichment, triage).\n// One submission = one event: a double click creates two events (documented limit of a plain form).\nconst f = $input.first().json;\nconst pick = (...names) => names.map((n) => f[n]).find((v) => v !== undefined && v !== '');\nreturn [{ json: {\n  event_id: `form-${$execution.id}`,\n  equipment_id: String(pick('equipment_id', 'Equipment') || '').split(' ')[0],\n  reported_at: new Date().toISOString().slice(0, 19) + 'Z',\n  language: pick('language', 'Language') || 'fr',\n  description: pick('description', 'What happened?'),\n  operator_reference: pick('operator_reference', 'Your operator reference') || undefined,\n} }];"
      }
    },
    {
      "id": "0ed17d64-c836-5251-92f6-2c30eb92a358",
      "name": "Send to intake",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/rf-intake",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "rfCredIntakeKey1",
          "name": "RF Intake Webhook Key"
        }
      },
      "retryOnFail": false
    }
