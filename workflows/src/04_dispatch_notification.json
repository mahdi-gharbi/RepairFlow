      "parameters": {
        "fromEmail": "RepairFlow <repairflow@repairflow.local>",
        "toEmail": "={{ $json.body.args.to }}",
        "subject": "={{ $json.body.args.subject }} [{{ $json.body.context.message_marker }}]",
        "emailFormat": "text",
        "text": "=A maintenance ticket was created after human approval.\n\nTicket: {{ $json.body.context.ticket_reference }}\nEquipment: {{ $json.body.args.equipment_id }}\nIncident: {{ $json.body.args.incident_id }}\nAction: {{ $json.body.action_id }} (attempt {{ $json.body.attempt }})\n",
        "options": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "72fdaeae-a2ec-5569-a27a-281ba00576d7",
      "name": "Classify email result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ],
      "parameters": {
        "jsCode": "// SMTP has no idempotency key. Connection refused = nothing sent (retryable); auth/recipient\n// rejection = permanent; anything else after the transaction may have started = ambiguous.\nconst hook = $('Dispatch webhook').first().json.body;\nconst r = $input.first().json;\nlet outcome, ref = null, detail = null;\nif (r.messageId && Array.isArray(r.accepted) && r.accepted.length > 0) { outcome = 'succeeded'; ref = r.messageId; }\nelse {\n  detail = (typeof r.error === 'string' ? r.error : JSON.stringify(r.error || r)).slice(0, 300);\n  if (/ECONNREFUSED|ENOTFOUND|EAI_AGAIN/.test(detail)) outcome = 'retryable';\n  else if (/EAUTH|Invalid login|EENVELOPE|\\b55[0-4]\\b/i.test(detail)) outcome = 'permanent';\n  else outcome = 'ambiguous';\n}\nreturn [{ json: { action_id: hook.action_id, ack: { fencing_token: hook.fencing_token, dispatch_token: hook.dispatch_token,\n  outcome, provider_reference: ref, http_status: null, retry_after_s: null, detail } } }];"
      }
    },
    {
      "id": "72619c01-75b7-54dc-8334-722efdba704a",
      "name": "Ack",
      "type": "n8n-nodes-base.httpRequest",
