# Copy to .env with `python scripts/init_env.py` (generates random secrets).
# Every value below is a placeholder; never commit a real .env.

POSTGRES_PASSWORD=change-me
RF_DB_PASSWORD=change-me
N8N_DB_PASSWORD=change-me
TICKETS_DB_PASSWORD=change-me

# n8n encrypts stored credentials with this key. Losing it = re-provision credentials.
N8N_ENCRYPTION_KEY=change-me

# Shared secrets (header auth). Each one has a single purpose.
RF_INTERNAL_KEY=change-me        # n8n -> API internal endpoints (X-RepairFlow-Internal)
RF_INTAKE_KEY=change-me          # client -> n8n intake webhook (X-Intake-Key)
RF_DISPATCH_KEY=change-me        # worker -> n8n dispatch webhooks (X-Dispatch-Key)
TICKET_API_KEY=change-me         # n8n -> ticket-service (X-Api-Key)
SIM_FAULTS_KEY=change-me         # test harness -> simulators fault injection (X-Faults-Key)

# n8n operator form (basic auth) at http://127.0.0.1:15678/form/rf-report
RF_FORM_USER=operator-demo
RF_FORM_PASSWORD=change-me

# Local demo users: token per user (Authorization: Bearer <token>).
RF_OPERATOR_TOKEN=change-me
RF_REVIEWER_TOKEN=change-me

# Optional remote LLM (OpenAI-compatible). Leave empty to run the rules engine only.
# Sends the (fictional) report, telemetry and manual excerpts to the provider.
GROQ_API_KEY=
