        "jsonBody": "={{ JSON.stringify($json.ack) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Correlation-Id",
              "value": "={{ $('Dispatch webhook').first().json.body.correlation_id }}"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "rfCredInternalK1",
          "name": "RF Internal API"
        }
      },
      "retryOnFail": false,
      "onError": "continueRegularOutput"
    }
